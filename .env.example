# API Configuration
# Base URL for the ASP.NET Core Backend API
VITE_API_BASE_URL=http://localhost:5000

# Identity & Access Management (Keycloak)
# The full URL to the Keycloak server (e.g., http://localhost:8080)
VITE_KEYCLOAK_URL=http://localhost:8080
# The Keycloak Realm name
VITE_KEYCLOAK_REALM=AuditNode-Realm
# The Client ID registered in Keycloak for this frontend
VITE_KEYCLOAK_CLIENT_ID=audit-frontend
