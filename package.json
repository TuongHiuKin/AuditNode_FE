{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=artifacts/vitest-junit.xml",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=artifacts/vitest-junit.xml",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "e2e:config": "docker compose -f e2e/stack/docker-compose.yml config",
    "test:e2e:fullstack": "playwright test --project=fullstack",
    "test:e2e:mocked": "playwright test --project=mocked",
    "test:smoke:staging": "playwright test --project=smoke-staging",
    "test:smoke:production": "playwright test --project=smoke-production",
    "test:e2e:headed": "playwright test --headed --project=fullstack",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "capture-openapi": "node scripts/capture-openapi.mjs",
    "create-openapi-metadata": "node scripts/create-openapi-metadata.mjs",
    "sync-api": "node scripts/sync-api.mjs",
    "sync-api:safe": "node scripts/sync-api.mjs",
    "sync-api:check": "node scripts/verify-api-contract.mjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@tanstack/react-query": "^5.100.11",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "^0.9.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-router": "7.13.0",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.7",
    "axios": "^1.16.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vitest": "^4.1.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
